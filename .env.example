# The key of the Custom Search JSON API, it belongs to the operator of the
# service. Get one in the Google Cloud console.
GOOGLE_CSE_API_KEY=your-api-key-here

# The id of the programmable search engine (the "cx" of the API).
GOOGLE_CSE_CX=your-search-engine-id-here

# Only changed for tests or for a private endpoint.
GOOGLE_CSE_ENDPOINT=https://www.googleapis.com/customsearch/v1

# The timeout of one request in seconds.
GOOGLE_CSE_TIMEOUT=10

# The highest number of hits one search may answer with.
GOOGLE_CSE_MAX_RESULTS=100
